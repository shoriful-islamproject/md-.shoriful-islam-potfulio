<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Google Map with Search</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: "Inter", sans-serif;
        }

        /* Map full screen */
        #map {
            height: 100vh;
            width: 100%;
        }

        /* Modern search box styling */
        #search-box {
            position: absolute;
            top: 15px;
            left: 50%;
            transform: translateX(-50%);
            width: 350px;
            z-index: 9999;
        }

        #search-input {
            width: 100%;
            padding: 12px 18px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }
    </style>
</head>

<body>

    <!-- Search box -->
    <div id="search-box">
        <input id="search-input" type="text" placeholder="Search a place..." />
    </div>

    <!-- Map -->
    <div id="map"></div>

    <!-- Google Maps API -->
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY_HERE&libraries=places&callback=initMap" async defer></script>

    <script>
        function initMap() {
            const initialPos = { lat: 40.7128, lng: -74.0060 }; // NYC

            // Create map
            const map = new google.maps.Map(document.getElementById("map"), {
                center: initialPos,
                zoom: 12,
            });

            // Marker
            const marker = new google.maps.Marker({
                map: map,
                position: initialPos,
            });

            // Search input
            const input = document.getElementById("search-input");
            const autocomplete = new google.maps.places.Autocomplete(input);

            autocomplete.bindTo("bounds", map);

            // When user selects a place
            autocomplete.addListener("place_changed", () => {
                const place = autocomplete.getPlace();

                if (!place.geometry) {
                    alert("No details available for input: '" + place.name + "'");
                    return;
                }

                // Move map to that place
                map.setCenter(place.geometry.location);
                map.setZoom(15);

                // Move marker
                marker.setPosition(place.geometry.location);
            });
        }
    </script>

</body>
</html>

 