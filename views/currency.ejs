<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>currency conver</title>
    <link rel="stylesheet" href="../style/currency.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <%- include ('partials/nav.ejs') %>
    <div id="container">
             <h2>currency Converter</h2>
            <form>
                <div class="amount" >
                   <p>Enter your amount</p>
                    <input value="100"type="text"/>
                </div>
                <div class="dropdown">
                   <div class="from">
                      <p>form</p>
                       <div class=" select-container">
                          <img src="https://flagsapi.com/US/flat/64.png">
                          <select name="form">
                               <option value="USD">USD</option>
                               <option value="BD">BDT</option>
                               <option value="INR">INR</option>
                               <option value="JPY">JPY</option>
                               <option value="OST">OST</option>
                            </select>
                        </div>
                    </div> 
                    <i class="fa-sharp fa-solid fa-arrow-right-arrow-left"></i>
                    <div class="from">
                        <p>TO</p>
                        <div class=" select-container">
                            <img src="https://flagsapi.com/BD/flat/64.png">
                            <select name="form">
                                 <option value="BD">BDT</option>
                                 <option value="USD">USD</option>
                                 <option value="INR">INR</option>
                                 <option value="JPY">JPY</option>
                                 <option value="OST">OST</option>
                            </select>
                        </div>
                    </div> 
                </div> 
                <div class="msg"> $1USD=120 BDt</div> 
                <button class="btn"onclick="">get excheng Ret</button>   
            </form>
    </div>
    <script src="../javascript/code.js"></script>

    <script src="../javascript/currency.js"></script>
</body>
</html>